---
import MainLayout from "../layouts/MainLayout.astro";

const githubHref = "https://github.com/whereissam/WiLens";
const downloadHref = `${githubHref}/releases/latest/download/WiLens.dmg`;
const quarantineCommand = "xattr -dr com.apple.quarantine /Applications/WiLens.app";

// A deterministic, QR-looking 21x21 grid: three finder squares plus noise.
const qrSize = 21;
const qrCells: Array<[number, number]> = [];
{
  let seed = 7;
  const rand = () => {
    seed = (seed * 9301 + 49297) % 233280;
    return seed / 233280;
  };
  const inFinder = (x: number, y: number) =>
    (x < 8 && y < 8) || (x > 12 && y < 8) || (x < 8 && y > 12);
  for (let y = 0; y < qrSize; y++) {
    for (let x = 0; x < qrSize; x++) {
      if (!inFinder(x, y) && rand() > 0.52) qrCells.push([x, y]);
    }
  }
}
const finders: Array<[number, number]> = [
  [0, 0],
  [14, 0],
  [0, 14],
];

const installSteps = [
  {
    title: "Drag to Applications",
    text: "Open WiLens.dmg and drag WiLens into Applications.",
  },
  {
    title: "Open it once",
    text: "macOS says it can't verify the developer. Click Done.",
  },
  {
    title: "Allow it",
    text: "System Settings → Privacy & Security → scroll down → Open Anyway.",
  },
];

const notes = [
  "Reads any standard Wi-Fi QR: router stickers, café menus, a friend's phone screen.",
  "Shows the network and security type first. Nothing joins until you click.",
  "Everything happens on your Mac. No account, no server, no analytics.",
  "Free and open source, MIT licensed.",
];
---

<MainLayout
  title="WiLens | Wi-Fi QR scanner for macOS"
  description="WiLens scans Wi-Fi QR codes with your Mac's camera, shows the network, and joins it. Free, open source, no accounts or tracking."
>
  <svg width="0" height="0" class="defs" aria-hidden="true">
    <defs>
      <symbol id="qr" viewBox="-2 -2 25 25">
        <rect x="-2" y="-2" width="25" height="25" fill="var(--print)" />
        {qrCells.map(([x, y]) => <rect x={x} y={y} width="1.02" height="1.02" />)}
        {finders.map(([x, y]) => (
          <g>
            <rect x={x + 0.5} y={y + 0.5} width="6" height="6" fill="none" stroke="currentColor" stroke-width="1" />
            <rect x={x + 2} y={y + 2} width="3" height="3" />
          </g>
        ))}
      </symbol>
    </defs>
  </svg>

  <header class="bar">
    <a class="wordmark" href="#top" aria-label="WiLens home">
      <img src="/app-icon-128.png" alt="" width="36" height="36" />
      <span>wilens</span>
    </a>
    <nav aria-label="Primary">
      <a href="#how">How it works</a>
      <a href="#install">Install</a>
      <a href={githubHref}>GitHub</a>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Switch theme"
        title="Lights on / darkroom"
      >
        <svg data-theme-icon viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.7 8.7 0 1 0 11.2 11.2Z" fill="currentColor" />
        </svg>
      </button>
    </nav>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="scribble">a tiny Mac app, made for one annoying moment</p>
        <h1 id="hero-title">
          Snap the <span class="nowrap">Wi-Fi</span> code.<br />
          <span class="underlined">Skip<svg class="squiggle" viewBox="0 0 200 18" preserveAspectRatio="none" aria-hidden="true">
              <path d="M3 12 C 30 4, 52 16, 80 9 S 130 4, 160 11 S 190 8, 197 6" />
            </svg></span> the password.
        </h1>
        <p class="lede">
          WiLens points your Mac's camera at a Wi-Fi QR code, shows you the
          network, and joins it. No more squinting at a 24-character password
          taped to the café counter.
        </p>
        <div class="actions">
          <a class="shutter" href={downloadHref}>
            <span class="shutter-dot" aria-hidden="true"></span>
            Download for macOS
          </a>
          <a class="text-link" href={githubHref}>View the source →</a>
        </div>
        <p class="meta">Apple Silicon · free · MIT · Windows build in beta</p>
      </div>

      <div class="camera" aria-hidden="true">
        <div class="camera-frame">
        <img class="camera-body" src="/app-icon.png" alt="" width="512" height="512" />
        <div class="slot">
          <div class="ticket">
            <p class="ticket-head">WILENS · SCAN #0042</p>
            <dl>
              <div><dt>NETWORK</dt><dd>Cafe_WiFi</dd></div>
              <div><dt>SECURITY</dt><dd>WPA2</dd></div>
              <div><dt>PASSWORD</dt><dd>••••••••••</dd></div>
              <div><dt>HIDDEN</dt><dd>no</dd></div>
            </dl>
            <p class="ticket-ok">✓ JOINED</p>
          </div>
        </div>
        </div>
      </div>
    </section>

    <section class="how" id="how" aria-labelledby="how-title">
      <div class="section-head">
        <h2 id="how-title">How it works</h2>
        <p class="scribble">three snaps, that's the whole thing</p>
      </div>

      <ol class="prints">
        <li class="print print-1">
          <span class="tape" aria-hidden="true"></span>
          <div class="photo photo-scan">
            <span class="corners" aria-hidden="true"></span>
            <svg class="qr" viewBox="-2 -2 25 25" role="img" aria-label="A Wi-Fi QR code">
              <use href="#qr" />
            </svg>
            <span class="scanline" aria-hidden="true"></span>
          </div>
          <p class="caption"><b>1</b> point it at the code</p>
        </li>

        <li class="print print-2">
          <span class="tape" aria-hidden="true"></span>
          <div class="photo photo-check">
            <div class="mini-card">
              <small>SCANNED NETWORK</small>
              <strong>Cafe_WiFi</strong>
              <span class="chips"><i>WPA2</i><i>••••••</i><i>visible</i></span>
            </div>
          </div>
          <p class="caption"><b>2</b> check it's the right one</p>
        </li>

        <li class="print print-3">
          <span class="tape" aria-hidden="true"></span>
          <div class="photo photo-join">
            <svg class="wifi" viewBox="0 0 64 48" aria-hidden="true">
              <path d="M4 16a40 40 0 0 1 56 0" />
              <path d="M14 26a26 26 0 0 1 36 0" />
              <path d="M24 36a12 12 0 0 1 16 0" />
              <circle cx="32" cy="43" r="3.4" />
            </svg>
            <span class="joined">connected</span>
          </div>
          <p class="caption"><b>3</b> join. done.</p>
        </li>
      </ol>
    </section>

    <section class="app" aria-labelledby="app-title">
      <figure class="big-print">
        <span class="tape tape-l" aria-hidden="true"></span>
        <span class="tape tape-r" aria-hidden="true"></span>
        <img
          src="/screenshot.png"
          alt="The WiLens window: camera viewfinder on the right, scanned network details below it."
          width="3008"
          height="1830"
          loading="lazy"
        />
        <figcaption>the whole app is one window</figcaption>
        <span class="stamp" aria-hidden="true">Nothing leaves<br />your Mac</span>
      </figure>

      <div class="notes">
        <h2 id="app-title">Small on purpose.</h2>
        <ul>
          {notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    </section>

    <section class="install" id="install" aria-labelledby="install-title">
      <div class="install-copy">
        <h2 id="install-title">Get it.</h2>
        <p>
          WiLens is a side project, so it isn't notarized by Apple (that costs
          $99 a year). macOS asks you to confirm the first launch. It takes
          about ten seconds.
        </p>
        <div class="actions">
          <a class="shutter" href={downloadHref}>
            <span class="shutter-dot" aria-hidden="true"></span>
            Download WiLens.dmg
          </a>
          <a class="text-link" href={`${githubHref}/releases`}>All releases →</a>
        </div>
      </div>

      <div class="receipt">
        <p class="receipt-head">INSTALL · APPLE SILICON</p>
        <ol>
          {installSteps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              <span>{step.text}</span>
            </li>
          ))}
        </ol>
        <p class="receipt-head">IF IT SAYS "DAMAGED"</p>
        <p class="receipt-note">Older downloads can trip this. Run once in Terminal, then open WiLens again:</p>
        <div class="command">
          <code>{quarantineCommand}</code>
          <button type="button" data-copy={quarantineCommand}>copy</button>
        </div>
        <p class="receipt-foot">THANK YOU · COME AGAIN</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p class="scribble">made on a Mac by <a href="https://github.com/whereissam">whereissam</a></p>
    <p><a href={githubHref}>GitHub</a> · MIT</p>
  </footer>

  <script is:inline>
    document.addEventListener("click", async (event) => {
      const button = event.target instanceof Element ? event.target.closest("[data-copy]") : null;
      if (!button) return;
      try {
        await navigator.clipboard.writeText(button.dataset.copy);
        button.textContent = "copied";
      } catch {
        button.textContent = "select it";
      }
      setTimeout(() => (button.textContent = "copy"), 1600);
    });
  </script>
</MainLayout>
